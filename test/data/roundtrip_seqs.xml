<?xml version="1.0" encoding="UTF-8"?>
<!--
  A deliberately awkward little tree for the Nexus <-> phyloXML round trips,
  carrying exactly the four things those trips are about: node names (internal
  ones too), branch lengths, support values and aligned molecular sequences.

  Written by hand, NOT generated by either writer, so it cannot agree with a
  bug in the code it tests. Every awkward part is here on purpose:

    - branch lengths of 0 (three of them). A zero-length branch is ordinary —
      identical sequences produce them, and a multifurcation read from Newick
      is a run of them — and the phyloXML writer used to drop every one as
      falsy, so a tree came back with those branches undefined.
    - a NEGATIVE branch length, which some distance methods produce and no
      writer may quietly clamp.
    - a name needing quotes in Newick/Nexus, and one with a space.
    - a tip with NO sequence, so the Nexus matrix has to carry a missing row
      and the reader has to not read it back as data.
    - support on internal nodes only, as bootstrap values really come.

  Branch lengths stay within nine decimals: that is the precision
  archaeopteryx.js asks its writers for, and a fixture demanding more would be
  testing the rounding rather than the round trip.
-->
<phyloxml xmlns="http://www.phyloxml.org">
 <phylogeny rooted="true">
  <name>roundtrip fixture</name>
  <clade>
   <name>root</name>
   <branch_length>0</branch_length>
   <clade>
    <name>mammals</name>
    <branch_length>0.123456789</branch_length>
    <confidence type="bootstrap">95</confidence>
    <clade>
     <name>Seba's bat</name>
     <branch_length>0.25</branch_length>
     <sequence type="protein">
      <mol_seq is_aligned="true">MKAL-IVQW</mol_seq>
     </sequence>
    </clade>
    <clade>
     <name>house mouse</name>
     <branch_length>0</branch_length>
     <sequence type="protein">
      <mol_seq is_aligned="true">MKAL-IWQW</mol_seq>
     </sequence>
    </clade>
   </clade>
   <clade>
    <name>birds</name>
    <branch_length>0.5</branch_length>
    <confidence type="bootstrap">80</confidence>
    <clade>
     <name>Gallus</name>
     <branch_length>-0.001</branch_length>
     <sequence type="protein">
      <mol_seq is_aligned="true">MKAL-IYQW</mol_seq>
     </sequence>
    </clade>
    <clade>
     <name>Anas</name>
     <branch_length>0</branch_length>
     <sequence type="protein">
      <mol_seq is_aligned="true">MK-LQIVQW</mol_seq>
     </sequence>
    </clade>
    <clade>
     <name>Corvus</name>
     <branch_length>0.0625</branch_length>
    </clade>
   </clade>
  </clade>
 </phylogeny>
</phyloxml>
