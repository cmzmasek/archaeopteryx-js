{
  "name": "archaeopteryx",
  "version": "2.3.2",
  "description": "Archaeopteryx.js is a software tool for the visualization and analysis of highly annotated phylogenetic trees.",
  "main": "archaeopteryx.js",
  "types": "archaeopteryx.d.ts",
  "exports": {
    ".": {
      "types": "./archaeopteryx.d.ts",
      "default": "./archaeopteryx.js"
    },
    "./forester": "./forester.js",
    "./package.json": "./package.json"
  },
  "files": [
    "archaeopteryx.js",
    "archaeopteryx.d.ts",
    "forester.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/forester_test.js && node test/search_test.js && node test/visualization_test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:sync": "cp archaeopteryx.js forester.js docs/lib/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmzmasek/archaeopteryx-js.git"
  },
  "dependencies": {
    "phyloxml": ">=0.9.16",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  },
  "keywords": [
    "archaeopteryx",
    "phyloXML",
    "evolution",
    "phylogenetics",
    "visualization"
  ],
  "author": "Chris Zmasek",
  "license": "LGPL-2.1-or-later",
  "bugs": {
    "url": "https://github.com/cmzmasek/archaeopteryx-js/issues"
  },
  "homepage": "https://github.com/cmzmasek/archaeopteryx-js#readme",
  "peerDependencies": {
    "canvg": "^4.0.3",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "canvg": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "svg2pdf.js": {
      "optional": true
    }
  }
}
